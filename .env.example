# Copy to .env and fill in real values. Loaded by python-decouple (see
# master_data/master_data/settings.py). Values below are safe placeholders.

# === Django core ===
DEBUG=True
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me
# Comma-separated, no spaces.
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_SERVICE=http://127.0.0.1:8000
# Command prefix save_db uses to re-invoke manage.py (e.g. "uv run", "python").
PYTHON_CMD=uv run

# === Databases (one per app; router sends each app's models to its own DB) ===
# default = auth/session, plus one each for master / sales / supplier / human_resource.
DB_DEFAULT_ENGINE=django.db.backends.mysql
DB_DEFAULT_NAME=center
DB_DEFAULT_USER=your_db_user
DB_DEFAULT_PASSWORD=your_db_password
DB_DEFAULT_HOST=localhost
DB_DEFAULT_PORT=3306

DB_MASTER_ENGINE=django.db.backends.mysql
DB_MASTER_NAME=master
DB_MASTER_USER=your_db_user
DB_MASTER_PASSWORD=your_db_password
DB_MASTER_HOST=localhost
DB_MASTER_PORT=3306

DB_SALES_ENGINE=django.db.backends.mysql
DB_SALES_NAME=sales
DB_SALES_USER=your_db_user
DB_SALES_PASSWORD=your_db_password
DB_SALES_HOST=localhost
DB_SALES_PORT=3306

DB_SUPPLIER_ENGINE=django.db.backends.mysql
DB_SUPPLIER_NAME=supplier
DB_SUPPLIER_USER=your_db_user
DB_SUPPLIER_PASSWORD=your_db_password
DB_SUPPLIER_HOST=localhost
DB_SUPPLIER_PORT=3306

DB_HR_ENGINE=django.db.backends.mysql
DB_HR_NAME=human_resource
DB_HR_USER=your_db_user
DB_HR_PASSWORD=your_db_password
DB_HR_HOST=localhost
DB_HR_PORT=3306

# === Static / media ===
STATIC_URL=static/
STATIC_ROOT=master_data/staticfiles
MEDIA_URL=media/
MEDIA_ROOT=master_data/media

# === Security (dev defaults shown; turn the flags on behind HTTPS) ===
SECURE_PROXY_SSL_HEADERS="HTTP_X_FORWARDED_PROTO","http"
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# === External API ===
# Base URL of the BCO / Jamet API the sales views call. Required.
API_JAMET=https://dev-bco.businesscorporateofficer.com/api
